Algoritmo Act1_Inc1_Lecc9
	Definir pesotot, pesoman, cantman Como Entero
	pesotot=0
	pesoman=0
	Mientras pesotot<1000 Hacer
		Escribir "Ingrese el peso de la manzana: "
		Leer pesoman
		
		pesotot=pesotot+pesoman
		cantman= cantman+1
		
		Escribir "El peso de las manzanas es: ",pesotot," y la cantidad que llevas es: ",cantman
	Fin Mientras
	
	Escribir "Llegaste al kilogramo de manzanas"
	Escribir "La cantidad de manzanas que llevaste son: ",cantman
	
	
FinAlgoritmo
